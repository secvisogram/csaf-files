  "vulnerabilities": [
    {
      "cve": "CVE-2026-114938",
      "cwe": {
        "id": "CWE-122",
        "name": "Heap-based Buffer Overflow"
      },
      "discovery_date": "2026-11-17T00:00:00.000Z",
      "notes": [
        {
          "category": "description",
          "text": "Heap out-of-bounds write in the AVX-512 Base64 decode intrinsic of the OpenJDK HotSpot compiler (java.util.Base64). It is exploitable only on x86-64 processors with AVX-512 VBMI support.",
          "title": "CVE Description"
        }
      ],
      "product_status": {
        "known_affected": [
          "CSAFPID-00001",
          "CSAFPID-00002",
          "CSAFPID-00003",
          "CSAFPID-00004",
          "CSAFPID-00005",
          "CSAFPID-00006",
          "CSAFPID-00007"
        ]
      },
      "remediations": [
        {
          "category": "workaround",
          "date": "2026-11-18T10:00:00.000Z",
          "details": "Start the JVM with the option -XX:-UseBASE64Intrinsics to disable the vulnerable intrinsic.",
          "product_ids": [
            "CSAFPID-00001",
            "CSAFPID-00002",
            "CSAFPID-00003",
            "CSAFPID-00004",
